# Copy to backend/.env and edit. No real secret ever belongs in this file or in the repo.
# The values below are the dev defaults and match docker-compose.yml.

APP_ENV=dev
LOG_LEVEL=INFO

# ---------------------------------------------------------------- database
# Runtime role: SELECT/INSERT on append-only tables, DML on the rest, no DDL.
DATABASE_URL=postgresql+psycopg://esign_app:esign_app_dev@localhost:54329/esign
# Migration role. Used by `python -m esign.migrate` and the test harness only.
DATABASE_OWNER_URL=postgresql+psycopg://esign_owner:esign_owner_dev@localhost:54329/esign
DB_ECHO=false

# ---------------------------------------------------------------- blob store
# fs | s3
BLOB_BACKEND=fs
BLOB_FS_ROOT=.blobstore
# s3 only:
BLOB_S3_BUCKET=
BLOB_S3_REGION=us-east-1
# BLOB_S3_ENDPOINT_URL=http://localhost:9100
BLOB_S3_PREFIX=esign/
# COMPLIANCE | GOVERNANCE
BLOB_S3_OBJECT_LOCK_MODE=COMPLIANCE
BLOB_S3_SSE=AES256
# BLOB_S3_SSE_KMS_KEY_ID=

# ---------------------------------------------------------------- sealing
# local | aws_kms. `local` reads the dev PKI from DEV_PKI_DIR (generated by `esign dev-pki`).
SEAL_KEY_BACKEND=local
# PAdES-B-T | PAdES-B-LT | PAdES-B-LTA. Production is B-LT or better; B-T in dev is a deliberate
# choice made here, never a silent downgrade.
SEAL_PROFILE=PAdES-B-T
DEV_PKI_DIR=.dev-pki
# aws_kms only. No private key material ever lives in an env var.
SEAL_KMS_KEY_ID=
SEAL_KMS_REGION=us-east-1
# SEAL_KMS_ENDPOINT_URL=
# SEAL_CERT_PATH=/etc/esign/seal.pem
# SEAL_CHAIN_PATH=/etc/esign/chain.pem
# RFC 3161 timestamp authority. Empty in unit tests, which use an in-process dummy.
TSA_URL=
TSA_TIMEOUT_SECONDS=10
# PEM bundle of the roots validate() may trust. A certificate embedded in a PDF never counts.
TRUST_ROOTS_PATH=.dev-pki/trust-roots.pem

# ---------------------------------------------------------------- identity
SESSION_TTL_SECONDS=1800
AUTH_MAX_AGE_SECONDS=43200
REAUTH_MAX_AGE_SECONDS=120
# Addendum 1 C: for how many seconds after its auth_time a re-authentication attestation also
# covers the same user's other sessions on the same host (a clinician re-authenticates once, then
# signs several documents). 0, the default, means an attestation covers exactly the one session it
# was made for -- one document -- which is the per-document proof the developer guide asks for.
# Turning it on trades that proof for convenience; every signer.signed then records whether the
# attestation was made in that session or borrowed (reauth_scope) and how old it was. At most 900
# (config.REAUTH_SPAN_MAX_SECONDS), which verification also re-checks: a borrowed attestation older
# than the cap is a finding years later, when this file's value is long forgotten.
# The attestation still has to be within REAUTH_MAX_AGE_SECONDS in every scope, so the window a
# queue actually gets is the smaller of the two: a span of 300 with the default maximum age of 120
# is a two-minute queue. The demo host runs with both at 300; production should leave the span at
# 0 unless compliance has agreed.
REAUTH_SPAN_SECONDS=0
# Comma-separated, or JSON. Only these peers' X-Forwarded-For is believed.
TRUSTED_PROXY_CIDRS=
DEFAULT_LOCALE=en-US

# ---------------------------------------------------------------- envelopes
APPROVED_DOCUMENT_TYPES=patient_consent,hipaa_acknowledgement,procedure_consent
# JSON object; anything not listed gets DEFAULT_RETENTION_YEARS.
RETENTION_YEARS_BY_DOCUMENT_TYPE={}
DEFAULT_RETENTION_YEARS=10
ENVELOPE_DEFAULT_TTL_DAYS=14

# ---------------------------------------------------------------- limits
MAX_TEMPLATE_BYTES=20971520
MAX_TEMPLATE_PAGES=50
# Addendum 1 A: bounds for a scan filed with POST /v1/archives (image-only pages are large).
MAX_SCAN_BYTES=20971520
MAX_SCAN_PAGES=100
MAX_SIGNATURE_PNG_BYTES=1048576
MAX_SIGNATURE_PNG_PIXELS=4000000
MAX_REQUEST_BYTES=8388608
MAX_SIGNATURE_PNG_DIMENSION=4000
MIN_SIGNATURE_PNG_DIMENSION=8
# The two client-supplied strings stamped into the document: a typed signature and a text field.
MAX_TYPED_SIGNATURE_CHARS=200
MAX_TEXT_FIELD_CHARS=2000

# ---------------------------------------------------------------- api and worker
# The built signing UI; served at /sign when the directory exists.
FRONTEND_DIST_DIR=../frontend/dist
TEMPLATES_DIR=../templates
WORKER_POLL_SECONDS=5
# A seal job claimed longer ago than this is assumed abandoned by a dead worker.
SEAL_JOB_LOCK_TIMEOUT_SECONDS=600
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=12
IDEMPOTENCY_TTL_HOURS=48
